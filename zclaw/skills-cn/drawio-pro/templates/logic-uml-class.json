      "methods": ["+execute() : Result", "+cancel() : void"],
      "color": "green", "layer": 1, "width": 200
    },
    {
      "id": "c3", "label": "DataAgent", "stereotype": "",
      "attributes": ["+dataSource : string", "-batchSize : int"],
      "methods": ["+process() : DataSet", "+export() : void"],
      "color": "green", "layer": 1, "width": 200
    },
    {
      "id": "c4", "label": "ITask", "stereotype": "<<interface>>",
      "attributes": [],
      "methods": ["+run() : void", "+getStatus() : Status"],
      "color": "orange", "layer": 0, "width": 180
    },
    {
